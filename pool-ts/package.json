{
  "name": "pool-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D pool/billiards game scaffold (Phaser 4 + Vite + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "phaser": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.7.0",
    "prettier": "3.9.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.0"
  }
}
