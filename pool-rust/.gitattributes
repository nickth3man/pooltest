# Auto-detect text files and normalize line endings to LF on checkout.
* text=auto eol=lf

# Source code
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.ron text eol=lf
