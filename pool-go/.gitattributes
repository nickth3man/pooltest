# Go source — always LF (gofmt outputs LF, CRLF would fail gofmt -l).
*.go       text eol=lf
go.mod     text eol=lf
go.sum     text eol=lf

# Makefiles and shell scripts — LF.
Makefile   text eol=lf
*.mk       text eol=lf
*.sh       text eol=lf

# Config / docs — LF.
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.toml     text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf

# Windows-only scripts — CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Binary assets — never normalize.
*.wasm     binary
*.exe      binary
*.png      binary
*.jpg      binary
*.ico      binary
*.wav      binary
*.mp3      binary
*.zip      binary
*.gz       binary
