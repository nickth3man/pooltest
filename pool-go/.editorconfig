# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Go is gofmt-mandated to use tabs.
[*.go]
indent_style = tab
indent_size = 4

# Makefile, go.mod, go.sum require tabs.
[{Makefile,go.mod,go.sum,.gitmodules}]
indent_style = tab

# YAML / JSON: 2-space indent.
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown: preserve trailing two-space line breaks.
[*.md]
trim_trailing_whitespace = false

# Windows-only scripts: CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf
